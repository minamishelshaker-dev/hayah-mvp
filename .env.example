# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED. Server only, never expose to the browser. Evidence writes (documents, signatures, consents)
# and rate limiting go through it; without it those actions fail.
SUPABASE_SERVICE_ROLE_KEY=

# Daily.co (optional: without it, the video page runs in demo mode)
DAILY_API_KEY=

# Resend (optional: without it, the invitation link is shown in the UI only)
# --- Mail: the platform sends the invitation to the SECOND party and the status notifications. Configure ONE provider.
# Option A, no domain needed: any SMTP account over TLS (port 465). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your Gmail address,
# SMTP_PASS = a Google "app password" (Google Account -> Security -> 2-Step Verification -> App passwords), MAIL_FROM=Hayah <your Gmail address>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Option B: Resend. The default onboarding@resend.dev sender delivers ONLY to the Resend account owner's own address (every other
# recipient is rejected). To write to anyone, verify a domain in Resend and set RESEND_FROM to an address on it.
RESEND_API_KEY=
RESEND_FROM=Hayah <onboarding@resend.dev>

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily audit anchor (emails the newest audit-log hash to you, outside the database)
CRON_SECRET=
ANCHOR_EMAIL=

# Ed25519 key that signs issued records (generate: npm run gen:signing-key). PEM with \n for line breaks.
# Keep the PUBLIC key of every key you ever used: old records stay verifiable only with their own key.
RECORD_SIGNING_PRIVATE_KEY=

# Optional hardening
# Switch the Content-Security-Policy header from report-only to blocking, after a full test (video call + every page).
CSP_ENFORCE=
# Optional malware scanner: receives the raw file by POST and must answer {"clean": true|false}.
# MALWARE_SCAN_REQUIRED=true rejects uploads when the scanner is unreachable (fail closed).
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
MALWARE_SCAN_REQUIRED=

